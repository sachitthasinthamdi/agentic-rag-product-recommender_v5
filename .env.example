# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — .env ไม่ถูก commit ขึ้น git

# ---- Ollama (ด่าน 5: LLM local) ----
# ต้องสตาร์ต server เองก่อนใช้งานทุกเซสชัน: ollama.exe serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=scb10x/llama3.1-typhoon2-8b-instruct
OLLAMA_EMBED_MODEL=bge-m3

# ---- Langfuse (ด่าน 13: Observability) — self-host ผ่าน docker-compose ----
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# ---- Vector DB ----
# ไม่มีค่าตั้งที่นี่ — ใช้ Chroma local อย่างเดียว (ดู ADR-0004) เก็บไฟล์ที่ data/embed/chroma/
# ไม่ต้องมี API key และไม่มีค่าใช้จ่าย
